{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "${HOME}/.config/fastfetch/images/arch.png",
        "type": "kitty-direct",
        "height": 18,
        "padding": {
            "top": 2
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "type": "custom",
            "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m"
        },
        "break",
        {
            "type": "title",
            "keyWidth": 10
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[97m╭─ \u001b[33msystem\u001b[90m ────────────────────────────────────────────────\u001b[0m"
        },
        {
            "type": "os",
            "key": "\u001b[97m│\u001b[33m  OS",
            "keyColor": "33",
            "keyWidth": 16
        },
        {
            "type": "kernel",
            "key": "\u001b[97m│\u001b[33m  Kernel",
            "keyColor": "33",
            "keyWidth": 16
        },
        {
            "type": "uptime",
            "key": "\u001b[97m│\u001b[33m  Uptime",
            "keyColor": "33",
            "keyWidth": 16
        },
        {
            "type": "command",
            "key": "\u001b[97m│\u001b[33m 󱦟 Age",
            "keyColor": "33",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
            "keyWidth": 16
        },
        {
            "type": "packages",
            "format": "{pacman} (pacman), {snap} (snap)",
            "key": "\u001b[97m│\u001b[33m  Packages",
            "keyColor": "33",
            "keyWidth": 16
        },
        {
            "type": "shell",
            "key": "\u001b[97m│\u001b[33m  Shell",
            "keyColor": "33",
            "keyWidth": 16
        },
        {
            "type": "custom",
            "format": "\u001b[97m╭─ \u001b[36mdesktop\u001b[90m ───────────────────────────────────────────────\u001b[0m"
        },
        {
            "type": "wm",
            "key": "\u001b[97m│\u001b[36m  WM",
            "keyColor": "36",
            "keyWidth": 16
        },
        {
            "type": "terminal",
            "key": "\u001b[97m│\u001b[36m  Terminal",
            "keyColor": "36",
            "keyWidth": 16
        },
        {
            "type": "display",
            "key": "\u001b[97m│\u001b[36m  Display",
            "keyColor": "36",
            "keyWidth": 16
        },
        {
            "type": "custom",
            "format": "\u001b[97m╭─ \u001b[35mhardware\u001b[90m ──────────────────────────────────────────────\u001b[0m"
        },
        {
            "type": "cpu",
            "format": "{1}",
            "key": "\u001b[97m│\u001b[35m  CPU",
            "keyColor": "35",
            "keyWidth": 16
        },
        {
            "type": "gpu",
            "format": "{2}",
            "key": "\u001b[97m│\u001b[35m  GPU",
            "keyColor": "35",
            "keyWidth": 16
        },
        {
            "type": "gpu",
            "format": "{3}",
            "key": "\u001b[97m│\u001b[35m  GPU",
            "keyColor": "35",
            "keyWidth": 16
        },
        {
            "type": "memory",
            "key": "\u001b[97m│\u001b[35m 󰍛 Memory",
            "keyColor": "35",
            "keyWidth": 16
        },
        {
            "type": "swap",
            "key": "\u001b[97m│\u001b[35m 󰾴 Swap",
            "keyColor": "35",
            "keyWidth": 16
        },
        {
            "type": "disk",
            "key": "\u001b[97m│\u001b[35m 󰃊 Disk",
            "keyColor": "35",
            "keyWidth": 16
        },
        {
            "type": "custom",
            "format": "\u001b[90m╰─────────────────────────────────────────────────────────\u001b[0m"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m"
        },
        "break",
        "break"
    ]
}