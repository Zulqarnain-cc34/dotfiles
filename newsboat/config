unbind-key j
unbind-key k
unbind-key h
unbind-key L
unbind-key H
unbind-key c
unbind-key ,
unbind-key RIGHT
unbind-key LEFT

browser "${HOME}/bin/bash_scripts/urlportal.sh"
feed-sort-order views


# Feed settings
prepopulate-query-feeds yes
refresh-on-startup yes
reload-threads 4                    # parallel
reload-only-visible-feeds yes       # manually reloading all feeds will only reload the currently visible feeds

suppress-first-reload yes           # do not reload feeds on first startup
scrolloff 10                        # keep cursor above and below set line
mark-as-read-on-hover yes
notify-beep yes
auto-reload                 yes
reload-time                 150
notify-program              "nb-notify"
notify-format               "New articles: %d\nTotal unread: %n article(s), %f feed(s)"
download-retries 4
download-timeout 120
keep-articles-days 120
feedlist-format             "%4n %9u %t"
articlelist-title-format    "%N %V - '%T' (%u unread, %t total)"
save-path ~/.newsboat/saved_articles
cleanup-on-quit yes
datetime-format "%b %d %Y" # date example: Mar 01 2017

# -- Bookmarks ---------------------------------------------------------
bookmark-cmd $NEWSBOAT_BOOKMARKS
bookmark-interactive yes
bookmark-autopilot no

# open in cli web browser
# w3m: https://www.youtube.com/watch?v=Z22cFTB-uqg
# tmux: https://www.youtube.com/watch?v=ZNM1KfqpyGo

# -- Macros ---------------------------------------------

# Standard usage: bind-key i macro-prefix
bind-key i macro-prefix

# Open in terminal w3m (uses $TERMINAL from environment)
macro o set browser "$TERMINAL w3m %u" ; open-in-browser ; set browser "${HOME}/bin/bash_scripts/urlportal.sh"

# Download and view image
macro i set browser "wget -O /tmp/newsboat.img %u && feh /tmp/newsboat.img &> /dev/null &" ; open-in-browser ; set browser "${HOME}/bin/bash_scripts/urlportal.sh"

# Reddit comments via tuir (maintained fork of the discontinued rtv)
macro r set browser "tuir -l %u" ; open-in-browser ; set browser "${HOME}/bin/bash_scripts/urlportal.sh"

# Media Player (mpv)
macro p set browser "mpv %u &> /dev/null &" ; open-in-browser ; set browser "${HOME}/bin/bash_scripts/urlportal.sh"

# YouTube comments/Search via Pipe-Viewer
macro c set browser "pipe-viewer --comments=\"%u\"" ; open-in-browser ; set browser "${HOME}/bin/bash_scripts/urlportal.sh"
macro s set browser "pipe-viewer" ; open-in-browser ; set browser "${HOME}/bin/bash_scripts/urlportal.sh"

# Copy URL to clipboard
macro y set browser "echo -n %u | xclip -selection clipboard" ; open-in-browser ; set browser "${HOME}/bin/bash_scripts/urlportal.sh"

# bind keys
bind-key h quit
bind-key BACKSPACE quit
bind-key j down
bind-key k up
bind-key H prev-feed
bind-key L next-feed
bind-key c toggle-show-read-feeds
#bind-key left open
bind-key l open
bind-key LEFT quit
bind-key RIGHT open

