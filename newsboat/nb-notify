#!/usr/bin/env bash
# A script for displaying newsboat notifications via libnotify

NBINFO=$1
(
    choice=$(dunstify -w -t 15000 -A "default,Open newsboat" --icon=internet-news-reader \
        "Newsboat - Feeds updated" "$NBINFO")
    [ "$choice" = "default" ] && $TERMINAL -e newsboat
) &
disown

