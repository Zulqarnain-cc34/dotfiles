#!/bin/sh
# BSPWM configuration script

[ -r "$HOME/.profile" ] && . "$HOME/.profile"
: "${TERMINAL:=kitty}"

[ -x "$HOME/.config/kitty/scripts/link-font-size.sh" ] && \
    "$HOME/.config/kitty/scripts/link-font-size.sh"

# Disable screen blanking and DPMS
xset s off
xset -dpms
xset s noblank

bspc monitor -d 一 二 三 四 五 六 七 八 九

bspc rule -r "*"

bspc config border_width 2
bspc config window_gap 2

bspc config split_ratio 0.50
bspc config borderless_monocle true
bspc config gapless_monocle true

###---Global Settings---###

bspc config automatic_scheme alternate
bspc config initial_polarity second_child
bspc config pointer_modifier lock
bspc config pointer_action1 move
bspc config pointer_action2 resize_side
bspc config pointer_action3 resize_corner
bspc config click_to_focus none

bspc config focus_follows_pointer true
bspc config remove_disabled_monitors true
bspc config remove_unplugged_monitors true
bspc config merge_overlapping_monitors true

bspc config normal_border_color "#4c566a"
bspc config active_border_color "#1e1e1e"
bspc config focused_border_color "#327bd1"
bspc config presel_feedback_color "#327bd1"

###---Monitor And Desktop Settings----###
# bspc config top_padding 32
# bspc config bottom_padding 0
# bspc config left_padding 0
# bspc config right_padding 0
# bspc config border_width 2
# bspc config window_gap 10

###---Rules---###
bspc rule -a mpv state=fullscreen
bspc rule -a Zathura state=tiled
bspc rule -a Gimp desktop='^8' state=floating follow=on
bspc rule -a Chromium desktop='^2'
bspc rule -a Kupfer.py focus=on
bspc rule -a Screenkey manage=off

# Start a daemon only if it isn't already running, so re-running bspwmrc
# (super+alt+r -> `bspc wm -r`) doesn't spawn a second copy of each.
run() { pgrep -x "$1" >/dev/null || "$@" & }

command -v conky >/dev/null && run conky -q -c "$HOME/.config/conky/conky1/conkyrc1"
run picom
run sxhkd
run dunst
command -v redshift >/dev/null && run redshift -c "$HOME/.config/redshift/redshift.conf"
# clipmenud is a shell script, so its process shows up as "bash", not
# "clipmenud" -- run()'s `pgrep -x "$1"` dedup can never match that, so it
# always tried to start a second copy and lost the lock race. Match on the
# full command line instead.
pgrep -f clipmenud >/dev/null || clipmenud &

# One-shot setup (harmless to re-run on reload)
xset r rate 300 50
# xset's repeat rate drifts mid-session (confirmed root cause: a udev-level
# keyboard device re-enumeration reinitializes it to X11's own default, not
# a suspend/resume event). This watches for that udev event directly and
# restores the rate the instant it happens, logging each real occurrence.
pgrep -f "xset-repeat-logger.sh" >/dev/null || "$HOME/bin/bash_scripts/system/xset-repeat-logger.sh" &
[ -x "$HOME/bin/bash_scripts/media/random-wallpaper.sh" ] && "$HOME/bin/bash_scripts/media/random-wallpaper.sh" &
[ -x "$HOME/.config/polybar/launch.sh" ] && "$HOME/.config/polybar/launch.sh" &
# Warm fastfetch's package-count cache now, so the first terminal of the
# session never has to pay the ~0.35s pacman query itself.
[ -x "$HOME/.config/fastfetch/scripts/pkgcount.sh" ] && "$HOME/.config/fastfetch/scripts/pkgcount.sh" >/dev/null 2>&1 &
