! X resources.
!
! Terminals here are kitty + alacritty, which do their own font rendering, so the
! old URxvt.* block and the dead `#include "~/etc/.configResources/..."` (which made
! `xrdb -merge` fail on the missing file) have been removed.
!
! The Xft.* hints below still matter — they affect X apps like rofi and dunst.

Xft.hinting:   true
Xft.rgba:      none
Xft.hintstyle: hintfull
Xft.lcdfilter: lcddefault
