cmd chmod %{{
  printf "Mode Bits: "
  read ans
  SAVEIFS=$IFS
  IFS=$(echo -en "\n\b")
  #for file in ${fx// /'>'}
  for file in $fx
  do
    chmod $ans "$file"
  done
  IFS=$SAVEIFS

  lf -remote 'send reload'
}}

