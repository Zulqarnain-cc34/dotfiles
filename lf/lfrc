cmd zip %{{
  set -- $fx
  last="$1"; for p in "$@"; do last="$p"; done
  dir="$(dirname "$last")"
  name="$(basename "$last")"
  cd "$dir" || exit 1
  out="$name.zip"; i=1
  while [ -e "$out" ]; do out="$name-$i.zip"; i=$((i+1)); done
  names=()
  for p in "$@"; do names+=("$(basename "$p")"); done
  zip -r "$out" "${names[@]}"
}}

