#!/bin/sh
case "$TERM" in
	# --clear doesn't need --place, so it never needs to read anything back
	# from the terminal (unlike image()'s --use-window-size case) -- only
	# writing to /dev/tty, so only SIGTTOU needs ignoring here, and there's
	# no read-side EOF risk to worry about. Ignore it *inside* the timeout'd
	# subshell since timeout resets signal dispositions before its own exec.
	*kitty*) timeout 1 sh -c 'trap "" TTOU; exec kitty +kitten icat --clear --stdin=no > /dev/tty 2>&1' ;;
esac
if [ -n "$FIFO_UEBERZUG" ]; then
	printf '{"action": "remove", "identifier": "PREVIEW"}\n' > "$FIFO_UEBERZUG"
fi
