#!/bin/sh
case "$TERM" in
	# Ignore SIGTTOU/SIGTTIN *inside* the timeout'd subshell -- lf runs this
	# script in a background process group, and icat's terminal read/write
	# would otherwise get job-control-stopped (not hung) touching /dev/tty.
	# timeout itself resets signal dispositions before exec, so the trap has
	# to be set after it, not before.
	*kitty*) timeout 1 sh -c 'trap "" TTOU TTIN; exec kitty +kitten icat --clear --stdin=no < /dev/tty > /dev/tty 2>&1' ;;
esac
if [ -n "$FIFO_UEBERZUG" ]; then
	printf '{"action": "remove", "identifier": "PREVIEW"}\n' > "$FIFO_UEBERZUG"
fi
