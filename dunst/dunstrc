[global]
    monitor = 1
    #   mouse: follow mouse pointer
    #   keyboard: follow window with keyboard focus
    #   none: don't follow anything
    follow = none
    # `geometry` was removed in dunst 1.7; split into width/height/origin/offset.
    # Old "500x5-30+50" = width 500, anchored top-right, 30x50 offset.
    width = 500
    # height is a (min, max) range in this dunst version; 300 is just the cap,
    # notifications shrink to fit their actual content.
    height = (0, 300)
    origin = "top-right"
    offset = (30, 50)
    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 16
    horizontal_padding = 16
    # frame_width = 0 disables the frame outright, which made the per-urgency
    # frame_color below invisible no matter what it was set to.
    frame_width = 2
    # Palette matches polybar/colors.ini (Atom One Dark).
    frame_color = "#3F5360"
    gap_size = 4
    separator_color = frame
    sort = yes
    idle_threshold = 120

    ### Text ###

    font = "SauceCodePro Nerd Font 11"
    line_height = 0

    # Possible values are:
    # full: Allow a small subset of html markup in notifications:
    #        <b>bold</b>
    #        <i>italic</i>
    #        <s>strikethrough</s>
    #        <u>underline</u>
    #
    #        For a complete reference see
    #        <https://developer.gnome.org/pango/stable/pango-Markup.html>.
    #
    # strip: This setting is provided for compatibility with some broken
    #        clients that send markup even though it's not enabled on the
    #        server. Dunst will try to strip the markup but the parsing is
    #        simplistic so using this option outside of matching rules for
    #        specific applications *IS GREATLY DISCOURAGED*.
    #
    # no:    Disable markup parsing, incoming notifications will be treated as
    #        plain text. Dunst will not advertise that it has the body-markup
    #        capability if this is set as a global setting.
    #
    # It's important to note that markup inside the format option will be parsed
    # regardless of what this is set to.
    markup = full

    # The format of the message.  Possible variables are:
    #   %a  appname
    #   %s  summary
    #   %b  body
    #   %i  iconname (including its path)
    #   %I  iconname (without its path)
    #   %p  progress value if set ([  0%] to [100%]) or nothing
    #   %n  progress value if set without any extra characters
    #   %%  Literal %
    # Markup is allowed
    format = "<b>%s</b>\n%b"

    # Possible values are "left", "center" and "right".
    alignment = left
    # Possible values are "top", "center" and "bottom".
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    ### Icons ###

    icon_position = left
    min_icon_size = 0
    max_icon_size = 32
    # gnome-icon-theme was dropped from Arch; use dunst's recursive lookup (1.9+)
    # against an installed theme instead of hardcoded 16x16 gnome paths.
    enable_recursive_icon_lookup = true
    icon_theme = "Papirus-Dark, Adwaita, hicolor"
    icon_corners = all

    sticky_history = yes
    history_length = 20

    ### Misc/Advanced ###
    dmenu = rofi -dmenu -p dunst:
    browser = xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 10
    corners = all
    progress_bar_corners = all
    ignore_dbusclose = false

    ### mouse

    # Defines list of actions for each mouse event
    # Possible values are:
    # * none: Don't do anything.
    # * do_action: If the notification has exactly one action, or one is marked as default,
    #              invoke it. If there are multiple and no default, open the context menu.
    # * close_current: Close current notification.
    # * close_all: Close all notifications.
    # These values can be strung together for each mouse event, and
    # will be executed in sequence.
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

# Experimental features that may or may not work correctly. Do not expect them
# to have a consistent behaviour across releases.
[experimental]
    # Calculate the dpi to use on a per-monitor basis.
    # If this setting is enabled the Xft.dpi value will be ignored and instead
    # dunst will attempt to calculate an appropriate dpi value for each monitor
    # using the resolution and physical size. This might be useful in setups
    # where there are multiple screens with very different dpi values.
    per_monitor_dpi = false

[urgency_low]
timeout = 2
background = "#282C34"
foreground = "#ABB2BF"
frame_color = "#98C379"
[urgency_normal]
timeout = 5
background = "#282C34"
foreground = "#ABB2BF"
frame_color = "#61AFEF"
[urgency_critical]
timeout = 0
background = "#282C34"
foreground = "#ABB2BF"
frame_color = "#e06c75"

# Rules: see dunstrc(5) RULES. Messages are matched by appname/summary/body/
# category/desktop_entry/etc, and can override format/urgency/timeout/scripts.

# The do-not-disturb toggle's own confirmation ("DND: ON"/"OFF") needs to show
# even while paused, or turning DND on would look like the keybind did nothing.
[dnd_toggle_confirm]
appname = "dunst"
override_pause_level = 100

# Background download/torrent notifications shouldn't interrupt -- route them
# low-urgency and skip the popup, but keep them in history.
# notifytorrents calls plain `notify-send` (appname is generically
# "notify-send" for every script that does that), so match on its summary
# ("Torrents") instead -- matching appname here would silence everything.
[silent_downloads]
appname = "notify-send"
summary = "Torrents"
urgency = low
skip_display = true
