#!/usr/bin/env bash
#

# Get the target volume
target_vol=$(lsblk | fzf --reverse | sed 's/^[^[:alnum:]]*//' | cut -d' ' -f1)
if [[ -z "$target_vol" ]]; then
	echo "No volume selected, exiting"
	exit 1
fi
# Is it encrypted or something?
if [[ $(lsblk -o NAME,FSTYPE | sed 's/^[^[:alnum:]]*//' | grep "$target_vol" | awk '{print $2}') == "crypto_LUKS" ]]; then
	echo "Volume is encrypted"
	udisksctl unlock -b /dev/"$target_vol"
	lsblk -o NAME,MOUNTPOINT
	exit 0
fi
# Is it internal?
if [[ $(lsblk -o NAME,RM | sed 's/^[^[:alnum:]]*//' | grep "$target_vol " | awk '{print $2}') -eq 1 ]]; then
	removable=true
else
	removable=false
fi


# Adjust to proper device path
if [[ -e /dev/"$target_vol" ]]; then
	target_vol="/dev/$target_vol"
elif [[ -e /dev/mapper/"$target_vol" ]]; then
	target_vol="/dev/mapper/$target_vol"
else
	echo "Something went wrong, no such volume?"
fi

if $removable; then
	udisksctl mount -b "$target_vol"
	echo "Press Return to continue"
	read 
else
	# Default to /mnt/<device-name>, skipping any candidate that's already
	# a live mountpoint (findmnt -- avoids reusing something else's mount)
	# or a non-empty directory (would hide whatever's already in it).
	vol_name=$(basename "$target_vol")
	default_mp="/mnt/$vol_name"
	mountpoint="$default_mp"
	i=1
	while [[ -e "$mountpoint" ]] && { findmnt -rno TARGET "$mountpoint" >/dev/null 2>&1 || [[ -n "$(ls -A "$mountpoint" 2>/dev/null)" ]]; }; do
		mountpoint="$default_mp-$i"
		i=$((i + 1))
	done

	echo "Input mountpoint [$mountpoint]:"
	read -r input
	[[ -n "$input" ]] && mountpoint="$input"

	while ! [[ -d "$mountpoint" ]]; do
		if ! sudo mkdir -p "$mountpoint"; then
			echo "$mountpoint is not a possible mountpoint.
Input new mountpoint:"
			read -r mountpoint
		fi
	done
	sudo mount "$target_vol" "$mountpoint" && \
	echo "Mounted $target_vol to $mountpoint
Press Return to continue"
read
fi
