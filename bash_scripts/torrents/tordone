#!/bin/bash
# Run by transmission-daemon when a torrent finishes (settings.json's
# script-torrent-done-filename). Sends a notification with an "Open
# folder" action that opens the download in yazi.
#
# Backgrounded and disowned so transmission isn't kept waiting while the
# notification sits on screen. $TERMINAL falls back to kitty, since the
# daemon only has it if whatever started the daemon did.

(
    # dunst renders this body as pango markup, so a torrent name with a
    # literal "&"/"<"/">" would otherwise be parsed as markup -- an
    # unrecognized tag like "<foo>" fails to parse at all. Escape before
    # it ever reaches dunstify.
    name=$(printf '%s' "$TR_TORRENT_NAME" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')
    choice=$(dunstify -w -t 15000 -A "default,Open folder" \
        "Transmission-daemon" "$name has completely downloaded")
    [ "$choice" = "default" ] && "${TERMINAL:-kitty}" -e yazi "$TR_TORRENT_DIR"
) &
disown
