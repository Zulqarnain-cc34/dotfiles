# Overrides the autorandr package's own rule of the same name
# (/usr/lib/udev/rules.d/40-monitor-hotplug.rules), which starts a *system*
# autorandr.service with no DISPLAY/XAUTHORITY -- it can never reach the X
# server (confirmed: "Can't open display :0" on every run). This targets the
# user-session unit (systemd/user/autorandr.service) instead, which inherits
# the real session's DISPLAY/XAUTHORITY. The target user is whoever owns the
# active session on seat0, so nothing here is tied to one account. ($$ is
# udev's escape for a literal $.)
ACTION=="change", SUBSYSTEM=="drm", RUN+="/bin/sh -c 'user=$$(/usr/bin/loginctl show-session $$(/usr/bin/loginctl show-seat seat0 -p ActiveSession --value) -p Name --value) && exec /usr/bin/systemctl --user --machine=$$user@.host start autorandr.service'"
