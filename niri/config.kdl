// Niri config for dotfiles_v2 — scrollable-tiling Wayland compositor
// Docs: https://niri-wm.github.io/niri/Configuration:-Introduction
// Validate: niri validate -c ~/.config/niri/config.kdl

input {
    keyboard {
        xkb {
            // Matches ~/.Xmodmap caps/escape swap
            options "caps:swapescape"
        }
        repeat-delay 300
        repeat-rate 50
    }

    touchpad {
        tap
        natural-scroll
    }

    // Like bspwm focus_follows_pointer
    focus-follows-mouse max-scroll-amount="0%"
}

layout {
    gaps 2

    focus-ring {
        width 2
        active-color "#327bd1"
        inactive-color "#4c566a"
    }

    border {
        off
    }

    default-column-width { proportion 0.5; }
}

environment {
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    XDG_SESSION_DESKTOP "niri"

    TERMINAL "kitty"
    EDITOR "nvim"
    BROWSER "firefox"

    MOZ_ENABLE_WAYLAND "1"
    QT_QPA_PLATFORM "wayland;xcb"
    QT_QPA_PLATFORMTHEME "qt6ct"
    GDK_BACKEND "wayland,x11"
    SDL_VIDEODRIVER "wayland"
    OZONE_PLATFORM "wayland"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
}

// X11 apps: niri creates the X11 socket, sets $DISPLAY, and starts
// xwayland-satellite on demand (>= 0.7). Do not spawn-at-startup it manually.
xwayland-satellite {
    path "xwayland-satellite"
}

// Session autostart (X11-only tools like picom/sxhkd/bspwm are not started here)
spawn-at-startup "dunst"
spawn-at-startup "waybar"
spawn-at-startup "gammastep"
spawn-at-startup "wl-paste" "--watch" "cliphist" "store"
spawn-sh-at-startup "$HOME/.config/niri/autostart.sh"

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

screenshot-path "~/Pictures/screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

window-rule {
    match app-id=r#"^mpv$"#
    open-maximized true
}

window-rule {
    match app-id=r#"^org\.pwmt\.zathura$"#
    open-maximized false
}

window-rule {
    match app-id=r#"^firefox$"#
    match app-id=r#"^org\.mozilla\.firefox$"#
    match title="^Picture-in-Picture$"
    open-floating true
}

// Workspaces: dynamic (not named). Waybar maps index 1–9 → 一 二 … and hide-empty.
// Named workspaces always exist in niri, so hide-empty cannot hide unused 一–九.

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // --- Applications (mirrors sxhkd) ---
    Mod+T hotkey-overlay-title="Terminal: kitty" { spawn "kitty"; }
    Mod+R hotkey-overlay-title="Reddit: rtv" { spawn-sh "kitty -e rtv"; }
    Mod+Y hotkey-overlay-title="YouTube: ytfzf" { spawn-sh "$HOME/bin/bash_scripts/ytfzf -D"; }
    Mod+O hotkey-overlay-title="System monitor: htop" { spawn-sh "kitty -e htop"; }
    Mod+W hotkey-overlay-title="Browser: firefox" { spawn "firefox"; }

    Mod+Space hotkey-overlay-title="Rofi bangs" { spawn "rofi-bangs"; }
    Mod+Shift+Space hotkey-overlay-title="App launcher" { spawn-sh "$HOME/.config/rofi/launchers/ribbon/launcher.sh"; }
    Mod+M hotkey-overlay-title="Mail: neomutt" { spawn-sh "kitty -e neomutt"; }
    Mod+P hotkey-overlay-title="Powermenu" { spawn-sh "$HOME/.config/niri/powermenu.sh"; }

    Alt+N hotkey-overlay-title="News: newsboat" { spawn-sh "kitty -e newsboat"; }
    Alt+L hotkey-overlay-title="Lock screen" { spawn "swaylock"; }

  Mod+V hotkey-overlay-title="Clipboard history" {
        spawn-sh "cliphist list | rofi -dmenu -i -p clipboard | cliphist decode | wl-copy";
    }

    // --- Window / layout ---
    Mod+Q repeat=false { close-window; }
    Mod+Shift+Q repeat=false { close-window; }
    Mod+D hotkey-overlay-title="Toggle floating" { toggle-window-floating; }
    Mod+F hotkey-overlay-title="Maximize column" { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    Mod+Left { focus-column-left; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }

    Mod+Ctrl+Left { move-column-left; }
    Mod+Ctrl+Down { move-window-down; }
    Mod+Ctrl+Up { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H { move-column-left; }
    Mod+Ctrl+J { move-window-down; }
    Mod+Ctrl+K { move-window-up; }
    Mod+Ctrl+L { move-column-right; }

    // Switch monitor (needs 2+ outputs; nested niri preview only ever has one)
    Mod+Shift+Left { focus-monitor-previous; }
    Mod+Shift+Right { focus-monitor-next; }
    Mod+Shift+Up { focus-monitor-up; }
    Mod+Shift+Down { focus-monitor-down; }
    Mod+Shift+H { focus-monitor-previous; }
    Mod+Shift+L { focus-monitor-next; }
    Mod+Shift+K { focus-monitor-up; }
    Mod+Shift+J { focus-monitor-down; }

    // Move window to prev/next workspace (matches sxhkd: shift+ctrl+Left/Right)
    Ctrl+Shift+Left { move-column-to-workspace-up; }
    Ctrl+Shift+Right { move-column-to-workspace-down; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    Ctrl+Alt+Left { focus-workspace-up; }
    Ctrl+Alt+Right { focus-workspace-down; }
    Alt+Tab { focus-workspace-previous; }

    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Ctrl+R { reset-window-height; }

    Mod+Shift+O hotkey-overlay-title="Overview" { toggle-overview; }
    Mod+Shift+W hotkey-overlay-title="Tabbed column" { toggle-column-tabbed-display; }

    // --- Screenshots ---
    Print { screenshot; }
    Shift+Print hotkey-overlay-title="Screenshot region" { spawn-sh "grim -g \"$(slurp)\" \"$HOME/Pictures/screenshots/$(date +%Y%m%d-%H%M%S).png\""; }

    // --- Media / brightness ---
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioPlay allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    // --- Session ---
    Mod+Shift+X hotkey-overlay-title="Reload niri config" { spawn-sh "niri msg action load-config-file"; }
    Mod+Alt+Q hotkey-overlay-title="Quit niri" { quit; }
    Mod+Shift+S hotkey-overlay-title="Shutdown" {
        spawn-sh "printf 'Shutdown\\nReboot\\nCancel' | rofi -dmenu -p power | while read -r choice; do case \"$choice\" in Shutdown) systemctl poweroff;; Reboot) systemctl reboot;; esac; done";
    }
}
