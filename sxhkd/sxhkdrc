#######################################################################
#                           BSPWM BINDINGS                            #
#######################################################################


# quit/restart bspwm
super + alt + {q,r}
	bspc {quit, wm -r}

# Toggle floating
super + d
    if [ -z "$(bspc query -N -n focused.floating)" ]; then \
        bspc node focused -t floating; \
    else \
        bspc node focused -t tiled; \
    fi

# Shutdown and Reboot
super + shift + {r, s}
  prompt {"Are you sure you would like to reboot?" "sudo reboot", "Are you sure you would like to shutdown" "sudo shutdown"}

# close and kill
super + {_,shift + }q
	bspc node -{c,k}

# Send focused window to another workspace
super + {_, shift + }{1-8}
	bspc {desktop -f, node -d} '^{1-8}'

# Focus on window in direction
super + {h,j,k,l}
	bspc node -f {west,south,north,east}

# Switch Workspace
ctrl + alt + {Right, Left}
	bspc desktop -f {next.local, prev.local}

# Switch to last open workspace
alt + {Tab, grave}
	bspc {node, desktop} -f last

# Fullscreen or Monocle
super + f
	bspc desktop -l next

#######################################################################
#                              Preselect                              #
#######################################################################

# preselect the direction
super + ctrl + {h,j,k,l}
	bspc node -p {west,south,north,east}

# preselect the ratio
super + ctrl + {1-9}
	bspc node -o 0.{1-9}

# cancel the preselection for the focused node
super + ctrl + space
	bspc node -p cancel

# cancel the preselection for the focused desktop
super + ctrl + shift + space
	bspc query -N -d | xargs -I id -n 1 bspc node id -p cancel

#######################################################################
#                             MOVE/RESIZE                             #
#######################################################################

# move focused window to the next workspace and then switch to that workspace
shift + ctrl + {Left,Right}
    id=$(bspc query --nodes --node); bspc node --to-desktop {prev,next}; bspc desktop --focus next; bspc node --focus ${id}

# expand a window by moving one of its side outward
super + alt + {h,j,k,l}
	bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# contract a window by moving one of its side inward
super + alt + shift + {h,j,k,l}
	bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}

# move a floating window
super + {Left,Down,Up,Right}
	bspc node -v {-20 0,0 20,0 -20,20 0}

super + v
    CM_LAUNCHER=rofi clipmenu

#######################################################################
#                           SYSTEM CONTROLS                           #
#######################################################################

# Restart hotkey damon
super + shift + x
  killandnotify "sxhkd" "Config reloaded" && sxhkd &

# Lock the screen
alt + l
  slock

#######################################################################
#                            APPLICATIONS                             #
#######################################################################

# Notify Running Torrents
shift + alt + t
    notifytorrents

super + {t,r,y,o,w,e}
    {$TERMINAL,$TERMINAL -e rtv,$HOME/bin/bash_scripts/ytfzf -D,$TERMINAL -e htop, firefox,$TERMINAL -e neomutt}

# super + space
#   rofi-bangs

super + space
   $HOME/.config/rofi/launchers/ribbon/launcher.sh

super + m
   $TERMINAL -e ncmpcpp

alt  + n
   $TERMINAL -e newsboat

super + p
   $HOME/.config/polybar/scripts/powermenu

# Screenshots (maim)
Print
    mkdir -p "$HOME/Pictures/screenshots" && maim -u "$HOME/Pictures/screenshots/$(date +%Y%m%d-%H%M%S).png"

shift + Print
    mkdir -p "$HOME/Pictures/screenshots" && maim -s -u "$HOME/Pictures/screenshots/$(date +%Y%m%d-%H%M%S).png"
